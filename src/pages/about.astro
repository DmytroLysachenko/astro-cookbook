---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import cookingHero from "@/images/cooking-hero.webp";
---

<BaseLayout
  title="About Cooking Spot"
  description="Learn about Cooking Spot, a collection of approachable recipes with ingredients, cooking times, and practical cooking steps."
>
  <article class="mx-auto max-w-4xl py-8 md:py-14">
    <p
      class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary"
    >
      About the Cookbook
    </p>
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">
      Make Something Good Today
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">
      Cooking Spot brings recipes from different cuisines into one
      easy-to-browse cookbook. Pick a dish, check the ingredients and time, then
      follow the steps at your own pace.
    </p>
    <Image
      src={cookingHero}
      alt="Fresh ingredients and prepared dishes in a kitchen"
      class="mt-9 w-full rounded-2xl object-cover shadow-md"
      widths={[640, 960, 1280]}
      sizes="(min-width: 1024px) 896px, 100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <section class="rounded-xl border border-border bg-white p-6">
        <h2 class="text-2xl font-bold">Explore by Taste</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          Filter recipes by cuisine or category, and sort them by time or title
          when you're choosing what to cook.
        </p>
      </section>
      <section class="rounded-xl border border-border bg-white p-6">
        <h2 class="text-2xl font-bold">Share Your Experience</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          Sign in to save favorites, rate recipes, and add comments for other
          cooks.
        </p>
      </section>
    </div>
    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href="/recipes"
        class="btn-primary inline-flex min-h-11 items-center font-semibold"
        >Browse Recipes</a
      >
      <a
        href="/contact-us"
        class="inline-flex min-h-11 items-center font-semibold text-primary underline underline-offset-4"
        >Contact Us</a
      >
    </div>
  </article>
</BaseLayout>
