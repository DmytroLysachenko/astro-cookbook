---
import { getCollection } from "astro:content";

import { capitalize } from "@/lib/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FilterSidebar from "@/components/astro/filter/FilterSidebar.astro";
import RecipesList from "@/components/astro/recipe-cards/RecipesList.astro";
import { queryRecipes } from "@/lib/recipe-query";
import Pagination from "@/components/astro/pages-structure/Pagination.astro";

export const prerender = false;

const allRecipes = await getCollection("recipe");
const {
  recipes: currentRecipes,
  categories: allCategories,
  cuisines: allCuisines,
  category,
  cuisine,
  sort: sortBy,
  page: currentPage,
  total: totalRecipes,
  totalPages,
  start: rangeStart,
  end: rangeEnd,
} = queryRecipes(allRecipes, Astro.url.searchParams);
const pageTitle = category
  ? `${capitalize(category)} Recipes`
  : cuisine
    ? `${cuisine} Cuisine Recipes`
    : "All Recipes";
const pageParams = new URLSearchParams();
if (sortBy !== "title") pageParams.set("sort", sortBy);
if (category) pageParams.set("category", category);
if (cuisine) pageParams.set("cuisine", cuisine);
const baseUrl = `/recipes?${pageParams.toString()}${pageParams.size ? "&" : ""}page=`;
---

<BaseLayout
  background={true}
  noindex={Boolean(Astro.url.search)}
  title={`${pageTitle} | Cooking Spot`}
  description={`Browse ${totalRecipes} ${pageTitle.toLowerCase()} with cooking times, ingredients, and step-by-step instructions.`}
>
  <div class="mx-auto px-4">
    <div class="flex flex-col lg:flex-row gap-8">
      <FilterSidebar
        categories={allCategories}
        cuisines={allCuisines}
        currentCategory={category}
        currentCuisine={cuisine}
        currentSort={sortBy}
      />

      <div class="flex-1">
        <div class="flex justify-between items-center mb-8">
          <h1 class="text-2xl font-bold">
            {pageTitle}
          </h1>
          <div class="text-sm text-gray-600">
            Showing {rangeStart}-{rangeEnd} of {totalRecipes} recipes
          </div>
        </div>

        {
          currentRecipes.length ? (
            <RecipesList recipes={currentRecipes} />
          ) : (
            <p>
              No recipes match these filters.{" "}
              <a href="/recipes" class="underline">
                View all recipes
              </a>
              .
            </p>
          )
        }

        {
          totalPages > 1 && (
            <Pagination
              currentPage={currentPage}
              totalPages={totalPages}
              baseUrl={baseUrl}
            />
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
