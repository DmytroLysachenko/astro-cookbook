---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact Cooking Spot"
  description="Send Cooking Spot a recipe suggestion, correction, or question by email."
>
  <section class="mx-auto max-w-3xl py-12 md:py-20">
    <p
      class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary"
    >
      Get in Touch
    </p>
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">
      Let's Talk About Food
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">
      Have a question about a recipe, found a correction, or want to suggest a
      dish? Send a message directly to the Cooking Spot maintainer.
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      <div class="rounded-xl border border-border bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold">Email</h2>
        <p class="mt-2 mb-5 text-muted-foreground">
          Open your email app to write a message.
        </p>
        <a
          class="btn-primary inline-flex min-h-11 items-center font-semibold"
          href="mailto:dlysachenko98@gmail.com?subject=Cooking%20Spot%20enquiry"
          >Write an Email</a
        >
      </div>
      <div class="rounded-xl border border-border bg-white p-6 shadow-sm">
        <h2 class="text-xl font-semibold">Project on GitHub</h2>
        <p class="mt-2 mb-5 text-muted-foreground">
          Report a site issue or explore the source code.
        </p>
        <a
          class="inline-flex min-h-11 items-center font-semibold text-primary underline underline-offset-4"
          href="https://github.com/DmytroLysachenko/astro-cookbook"
          >Visit the Repository</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
