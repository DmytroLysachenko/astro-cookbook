---
import { Image } from "astro:assets";
import { getCookingStep } from "@/lib/recipe-images";

interface Props {
  action?: string;
  className?: string;
  alt?: string;
}

const { action = "default", className = "", alt } = Astro.props;
const image = getCookingStep(action);
---

<div class={className}>
  <Image
    src={image}
    alt={alt ?? action.replaceAll("-", " ")}
    widths={[320, 640]}
    sizes="(min-width: 1024px) 640px, 100vw"
    quality={70}
    loading="lazy"
    class="h-auto w-full lg:w-[65%]"
  />
</div>
