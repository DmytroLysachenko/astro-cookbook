---
import { Image } from "astro:assets";
import { capitalize } from "@/lib/utils";
import { getRecipePreview } from "@/lib/recipe-images";
import type { TRecipeCollectionEntry } from "@/types";

interface Props {
  recipe: TRecipeCollectionEntry;
  isFirst?: boolean;
}

const { recipe, isFirst } = Astro.props;
const {
  slug,
  previewImage,
  title,
  cuisine,
  cookingTime,
  portions,
  categories,
} = recipe.data;
const localImage = getRecipePreview(previewImage);
---

<div class="card">
  <a href={`/recipes/${slug}`} class="rounded-lg overflow-hidden block">
    <Image
      src={localImage}
      alt={title}
      width={400}
      height={250}
      class="w-full h-48 object-cover"
      widths={[320, 400, 640, 800]}
      sizes="(min-width: 1280px) 25vw, (min-width: 640px) 50vw, 100vw"
      quality={70}
      loading={isFirst ? "eager" : undefined}
      fetchpriority={isFirst ? "high" : undefined}
    />
  </a>

  <div class="p-4">
    <div class="text-sm uppercase font-medium text-gray-600 mb-1">
      {cuisine}
    </div>

    <h2 class="text-xl font-bold mb-2">
      <a
        href={`/recipes/${slug}`}
        class="text-gray-900 hover:text-red-500 transition-colors duration-300 line-clamp-2"
      >
        {title}
      </a>
    </h2>

    <p class="text-sm text-gray-600">
      Cook time: {cookingTime} minutes |
    </p>
    <p class="text-sm text-gray-600">
      Portions: {portions}
    </p>

    <div class="mt-2 flex flex-wrap gap-2">
      {
        categories.map((category) => (
          <a
            class="text-xs bg-gray-200 text-gray-700 px-2 py-1 rounded-full hover:bg-secondary/75 hover:text-white transition-colors duration-300"
            href={`/recipes?category=${category}`}
          >
            {capitalize(category)}
          </a>
        ))
      }
    </div>
  </div>
</div>
